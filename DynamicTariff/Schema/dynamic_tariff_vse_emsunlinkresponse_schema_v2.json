{
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "Dynamic Tariffs EMS Unlink Response",
  "description": "JSON schema for EMS unlink responses of the dynamic tariff price API",
  "type": "object",
  "properties": {
    "unlink_status": {
      "description": "The unlinking process status.",
      "$ref": "#/$defs/ems_unlink_status_code"
    }
  },
  "required": ["unlink_status"],
  "$defs": {
    "ems_unlink_status_code": {
      "description": "EMS unlink status codes.",
      "type": "string",
      "enum": [
        "link_removed",
        "link_not_found"
      ]
    }
  }
}
