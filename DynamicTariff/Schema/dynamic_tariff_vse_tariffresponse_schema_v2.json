{
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "Dynamic Tariff Prices Response",
  "description": "JSON schema for the delivery of dynamic tariff price values (VSE 2027)",
  "type": "object",
  "properties": {
    "publication_timestamp": {
      "description": "The time stamp of tariff publication, may be empty if not published",
      "type": "string",
      "anyOf": [
        { "format": "date-time" },
        { "format": "empty" }
      ]
    },
    "prices": {
      "description": "Contains the prices for the requested time intervals",
      "type": "array",
      "items": { "$ref": "#/$defs/tariff_price_item" }
    }
  },
  "additionalProperties": true,
  "required": [
    "publication_timestamp",
    "prices"
  ],
  "$defs": {
    "tariff_price_item": {
      "description": "A price item of a time interval, contains tariff types.",
      "type": "object",
      "properties": {
        "start_timestamp": {
          "description": "Begin of the time interval",
          "type": "string",
          "format": "date-time"
        },
        "end_timestamp": {
          "description": "End of the time interval",
          "type": "string",
          "format": "date-time"
        }
      },
      "anyOf": [
        {
          "properties": {
            "electricity": {
              "description": "Electricity price values in the interval",
              "$ref": "#/$defs/tariff_type_item"
            }
          }
        },
        {
          "properties": {
            "grid": {
              "description": "Grid price values in the interval",
              "$ref": "#/$defs/tariff_type_item"
            }
          }
        },
        {
          "properties": {
            "metering": {
              "description": "Metering price values in the interval",
              "$ref": "#/$defs/tariff_type_item"
            }
          }
        },
        {
          "properties": {
            "national_fees": {
              "description": "National fee price values in the interval",
              "$ref": "#/$defs/tariff_type_item"
            }
          }
        },
        {
          "properties": {
            "regional_fees": {
              "description": "Regional fee price values in the interval",
              "$ref": "#/$defs/tariff_type_item"
            }
          }
        },
        {
          "properties": {
            "dso": {
              "description": "DSO price values in the interval",
              "$ref": "#/$defs/tariff_type_item"
            }
          }
        },
        {
          "properties": {
            "dso_complete": {
              "description": "DSO price values in the interval (complete)",
              "$ref": "#/$defs/tariff_type_item"
            }
          }
        },
        {
          "properties": {
            "integrated": {
              "description": "Integrated price values in the interval",
              "$ref": "#/$defs/tariff_type_item"
            }
          }
        },
        {
          "properties": {
            "integrated_complete": {
              "description": "Integrated price values in the interval (complete)",
              "$ref": "#/$defs/tariff_type_item"
            }
          }
        },
        {
          "properties": {
            "feed_in": {
              "description": "Feed-in price values in the interval",
              "$ref": "#/$defs/tariff_type_item"
            }
          }
        },
        {
          "properties": {
            "refund": {
              "description": "Storage refund price values in the interval",
              "$ref": "#/$defs/tariff_type_item"
            }
          }
        }
      ],
      "required": [
        "start_timestamp",
        "end_timestamp"
      ],
      "additionalProperties": true
    },
    "tariff_type_item": {
      "description": "A tariff type in a time interval, contains tariff components.",
      "type": "object",
      "properties": {
        "tariff_name": {
          "description": "The tariff product associated with the tariff type.",
          "type": "string"
        },
        "standard_basegroup": {
          "description": "Defines if the tariff is a standard grid usage tariff for a base customer group",
          "type": "boolean"
        },
        "canton_taxes": {
          "description": "Defines if cantonal taxes are required",
          "type": "boolean"
        },
        "canton_name": {
          "description": "The canton name",
          "type": "string"
        },
        "municipality_taxes": {
          "description": "Defines if municipality taxes are required",
          "type": "boolean"
        },
        "municipality_number": {
          "description": "The municipality number from BFS",
          "type": "number",
          "format": "integer"
        },
        "municipality_name": {
          "description": "The municipality name",
          "type": "string"
        }
      },
      "anyOf": [
        {
          "properties": {
            "base": {
              "description": "Base prices",
              "$ref": "#/$defs/tariff_component_item"
            }
          }
        },
        {
          "properties": {
            "energy": {
              "description": "Energy-based prices",
              "$ref": "#/$defs/tariff_component_item"
            }
          }
        },
        {
          "properties": {
            "power": {
              "description": "Power-based prices",
              "$ref": "#/$defs/tariff_component_item"
            }
          }
        },
        {
          "properties": {
            "reactive_energy": {
              "description": "Reactive-energy-based prices",
              "$ref": "#/$defs/tariff_component_item"
            }
          }
        }
      ],
      "required": [
        "tariff_name"
      ]
    },
    "tariff_component_item": {
      "description": "A tariff component value.",
      "type": "object",
      "properties": {
        "unit": {
          "description": "The tariff unit",
          "$ref": "#/$defs/tariff_unit"
        },
        "value": {
          "description": "The numeric price value",
          "type": "number"
        }
      },
      "required": [
        "unit",
        "value"
      ]
    }
  },
  "tariff_unit": {
    "description": "Price units.",
    "type": "string",
    "enum": [
      "CHF/kWh",
      "CHF/kVarh",
      "CHF/y",
      "CHF/m",
      "CHF/w",
      "CHF/d",
      "CHF/12h",
      "CHF/6h",
      "CHF/4h",
      "CHF/2h",
      "CHF/1h",
      "CHF/30min",
      "CHF/15min",
      "CHF/kW/y",
      "CHF/kW/m",
      "CHF/kW/w",
      "CHF/kW/d",
      "CHF/kW/12h",
      "CHF/kW/6h",
      "CHF/kW/4h",
      "CHF/kW/2h",
      "CHF/kW/1h",
      "CHF/kW/30min",
      "CHF/kW/15min"
    ]
  }
}
