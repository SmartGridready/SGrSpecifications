{
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "Dynamic Tariffs VSE",
  "description": "JSON schema for the delivery of dynamic tariff price values (VSE 2027)",
  "type": "object",
  "properties": {
    "publication_timestamp": {
      "description": "The time stamp of tariff publication, may be empty if not published",
      "type": "string",
      "anyOf": [
        { "format": "date-time" },
        { "format": "empty" }
      ]
    },
    "prices": {
      "description": "Contains the prices for the requested time intervals",
      "type": "array",
      "items": { "$ref": "#/$defs/tariff_price_item" }
    }
  },
  "additionalProperties": true,
  "required": [
    "publication_timestamp",
    "prices"
  ],
  "$defs": {
    "tariff_price_item": {
      "type": "object",
      "properties": {
        "start_timestamp": {
          "description": "Begin of the time interval",
          "type": "string",
          "format": "date-time"
        },
        "end_timestamp": {
          "description": "End of the time interval",
          "type": "string",
          "format": "date-time"
        },
        "electricity": {
          "description": "Electricity price values in the interval",
          "$ref": "#/$defs/tariff_type_item"
        },
        "grid": {
          "description": "Grid price values in the interval",
          "allOf": [
            { "$ref": "#/$defs/grid_tariff_type" },
            { "$ref": "#/$defs/tariff_type_item" }
          ]
        },
        "metering": {
          "description": "Metering price values in the interval",
          "$ref": "#/$defs/tariff_type_item"
        },
        "national_fees": {
          "description": "National fee price values in the interval",
          "$ref": "#/$defs/tariff_type_item"
        },
        "regional_fees": {
          "description": "Regional fee price values in the interval",
          "allOf": [
            { "$ref": "#/$defs/regional_fees_tariff_type" },
            { "$ref": "#/$defs/tariff_type_item" }
          ]
        },
        "dso": {
          "description": "DSO price values in the interval",
          "$ref": "#/$defs/tariff_type_item"
        },
        "integrated": {
          "description": "Integrated price values in the interval",
          "$ref": "#/$defs/tariff_type_item"
        },
        "feed_in": {
          "description": "Feed-in price values in the interval",
          "$ref": "#/$defs/tariff_type_item"
        },
        "refund": {
          "description": "Storage refund price values in the interval",
          "$ref": "#/$defs/tariff_type_item"
        }
      },
      "required": [
        "start_timestamp",
        "end_timestamp"
      ],
      "additionalProperties": true
    },
    "tariff_type_item": {
      "type": "object",
      "properties": {
        "base": {
          "description": "Base prices",
          "$ref": "#/$defs/tariff_component_item"
        },
        "energy": {
          "description": "Energy-based prices",
          "$ref": "#/$defs/tariff_component_item"
        },
        "power": {
          "description": "Power-based prices",
          "$ref": "#/$defs/tariff_component_item"
        },
        "reactive_power": {
          "description": "Reactive-power-based prices",
          "$ref": "#/$defs/tariff_component_item"
        }
      }
    },
    "grid_tariff_type": {
      "type": "object",
      "properties": {
        "municipality_number": {
          "description": "The municipality number from BFS",
          "type": "number",
          "format": "integer"
        },
        "municipality_name": {
          "description": "The municipality name",
          "type": "string"
        }
      }
    },
    "regional_fees_tariff_type": {
      "type": "object",
      "properties": {
        "standard": {
          "description": "Defines if the tariff is a standard tariff",
          "type": "boolean"
        }
      }
    },
    "tariff_component_item": {
      "type": "object",
      "properties": {
        "unit": {
          "description": "The tariff unit",
          "type": "string"
        },
        "value": {
          "description": "The numeric price value",
          "type": "number"
        }
      },
      "required": [
        "unit",
        "value"
      ]
    }
  }
}
